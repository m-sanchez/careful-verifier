{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "lib": ["es2022", "dom"]
  },
  "include": ["src/**/*.ts", "test/types-smoke.ts", "examples/**/*.ts"]
}
